# Run from this repository: ollama create qwen38-64k -f Modelfile
# Download the GGUF into models/ first. Paths are relative to this file.
FROM ./models/Qwen3.8-27B-UD-IQ3_S.gguf

RENDERER qwen3.8
PARSER qwen3.5

PARAMETER num_ctx 65536
PARAMETER num_batch 128
PARAMETER num_predict 8192
PARAMETER draft_num_predict 0

# Qwen's recommended sampling parameters for thinking mode.
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0.0
PARAMETER presence_penalty 0.0
PARAMETER repeat_penalty 1.0
